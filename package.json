{
  "name": "security-review",
  "version": "2.0.0",
  "description": "Whitebox security review, OWASP auditing, and developer-accelerated agent toolkit for Spec-Kit and AI workflows",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "security-review": "./bin/security-review.js",
    "sec-review": "./bin/security-review.js",
    "sr": "./bin/security-review.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "commands",
    "extension.yml",
    "config-template.yml",
    "examples",
    "docs",
    "landing"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cli": "tsx cli/index.ts"
  },
  "keywords": [
    "security",
    "owasp",
    "audit",
    "devsecops",
    "spec-kit",
    "ai-agent",
    "code-review"
  ],
  "author": "DyanGalih",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DyanGalih/security-review.git"
  },
  "homepage": "https://github.com/DyanGalih/security-review#readme",
  "bugs": {
    "url": "https://github.com/DyanGalih/security-review/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
